###############################################
# Ejemplo de variables de entorno (renombra a .env)
# NO coloques aquí tu token real si el repo se comparte.
###############################################

# Token largo de acceso (genera uno y ponlo SOLO en .env, aquí deja placeholder)
META_WHATSAPP_TOKEN=REEMPLAZA_CON_TOKEN_LARGO

# Phone Number ID (ID numérico, no el número con +52)
META_PHONE_NUMBER_ID=123456789012345

# (Opcional) Versión Graph (default v22.0)
META_GRAPH_VERSION=v22.0

# (Opcional) Alertas WhatsApp para órdenes de compra vencidas
# Comas, sólo dígitos. Ejemplo: 5215551234567,5213337654321
PO_ALERT_WHATSAPP=
# Cron estilo Linux (ej. 0 7 * * *). Usa "off" para desactivar.
PO_ALERT_CRON=0 7 * * *
# Zona horaria para el cron (default America/Mexico_City)
PO_ALERT_TZ=America/Mexico_City
# true para registrar sin enviar mensajes reales
PO_ALERT_DRY_RUN=true

# Puerto local (opcional)
PORT=3000

# Notas:
# 1. Copia este archivo a .env
# 2. Sustituye los valores reales SOLO en .env.
# 3. No subas .env al control de versiones.
# 4. Reinicia servidor tras cambios.
# 5. Verifica /health y /whatsapp-diagnose.
